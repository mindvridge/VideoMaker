# Development Environment Configuration
ENVIRONMENT=development
DEBUG=true

# CORS Settings (Allow all localhost variations)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Rate Limiting (More relaxed for development)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_GENERATE_PER_HOUR=100
RATE_LIMIT_UPLOAD_PER_HOUR=200

# AWS S3 Configuration (Optional for development - can use local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=video-gen-dev
CLOUDFRONT_DOMAIN=

# GPU Settings
CUDA_VISIBLE_DEVICES=0
ENABLE_CPU_OFFLOAD=true
USE_BF16=true
USE_FP16=false

# Celery Settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Model Settings
MODELS_CACHE_DIR=/root/.cache/huggingface
MAX_MODELS_IN_MEMORY=1

# Video Generation Defaults
DEFAULT_NUM_FRAMES=81
DEFAULT_FPS=8
DEFAULT_HEIGHT=720
DEFAULT_WIDTH=1280
MAX_VIDEO_DURATION=300

# File Upload
MAX_UPLOAD_SIZE=104857600  # 100MB for development

# FFmpeg Settings
FFMPEG_PRESET=ultrafast  # Faster encoding for development
FFMPEG_CRF=28
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_AUDIO_CODEC=aac

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
