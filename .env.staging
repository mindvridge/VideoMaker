# Staging Environment Configuration
ENVIRONMENT=staging
DEBUG=false

# CORS Settings (Specific staging URLs)
CORS_ORIGINS=https://staging.yourdomain.com,https://staging-api.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Rate Limiting (Moderate limits for staging)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_GENERATE_PER_HOUR=20
RATE_LIMIT_UPLOAD_PER_HOUR=40

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_staging_access_key
AWS_SECRET_ACCESS_KEY=your_staging_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=video-gen-staging
CLOUDFRONT_DOMAIN=staging-cdn.yourdomain.com

# GPU Settings
CUDA_VISIBLE_DEVICES=0
ENABLE_CPU_OFFLOAD=true
USE_BF16=true
USE_FP16=false

# Celery Settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Model Settings
MODELS_CACHE_DIR=/root/.cache/huggingface
MAX_MODELS_IN_MEMORY=1

# Video Generation Defaults
DEFAULT_NUM_FRAMES=81
DEFAULT_FPS=8
DEFAULT_HEIGHT=720
DEFAULT_WIDTH=1280
MAX_VIDEO_DURATION=300

# File Upload
MAX_UPLOAD_SIZE=52428800  # 50MB

# FFmpeg Settings
FFMPEG_PRESET=medium
FFMPEG_CRF=23
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_AUDIO_CODEC=aac

# Frontend
NEXT_PUBLIC_API_URL=https://staging-api.yourdomain.com
