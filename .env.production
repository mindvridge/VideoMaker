# Production Environment Configuration
ENVIRONMENT=production
DEBUG=false

# CORS Settings (Production URLs only)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept

# Rate Limiting (Strict limits for production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_GENERATE_PER_HOUR=10
RATE_LIMIT_UPLOAD_PER_HOUR=20

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_production_access_key
AWS_SECRET_ACCESS_KEY=your_production_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=video-gen-production
CLOUDFRONT_DOMAIN=cdn.yourdomain.com

# GPU Settings
CUDA_VISIBLE_DEVICES=0
ENABLE_CPU_OFFLOAD=true
USE_BF16=true
USE_FP16=false

# Celery Settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Model Settings
MODELS_CACHE_DIR=/root/.cache/huggingface
MAX_MODELS_IN_MEMORY=1

# Video Generation Defaults
DEFAULT_NUM_FRAMES=81
DEFAULT_FPS=8
DEFAULT_HEIGHT=720
DEFAULT_WIDTH=1280
MAX_VIDEO_DURATION=300

# File Upload
MAX_UPLOAD_SIZE=52428800  # 50MB

# FFmpeg Settings
FFMPEG_PRESET=slow  # Better quality for production
FFMPEG_CRF=20
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_AUDIO_CODEC=aac

# Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
